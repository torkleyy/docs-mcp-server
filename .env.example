# Copy this file to `.env` and fill in your credentials.

# OpenAI API key used for both embedding and chat models.
OPENAI_API_KEY=sk-...

# Optional: override the OpenAI API base URL.
# OPENAI_API_BASE=https://api.openai.com/v1

# Optional: specify the directory containing your Markdown docs.
# Defaults to ./docs if not set.
# DOCS_DIR=/path/to/your/docs

# Optional: choose specific model names.  The defaults are reasonable for
# most projects.
# OPENAI_CHAT_MODEL=gpt-3.5-turbo
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small